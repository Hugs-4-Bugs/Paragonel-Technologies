rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // SECURITY (Phase 4, IU-0 slice 2 — jobs/blogPosts CMS lockdown):
    //
    // Slice 1 moved PII collections (leads, jobApplications,
    // newsletterSubscribers, adminActivityLogs) server-side and locked them.
    //
    // Slice 2 (this change) does the same for the CMS content collections:
    //   * `jobs` and `blogPosts` WRITE is now DENIED to all client access.
    //     Admin CRUD (list/get/create/update/publish/unpublish/delete) runs
    //     through JWT-verified `/api/admin/jobs/**` and `/api/admin/blog/**`
    //     route handlers that use the Admin SDK (bypasses these rules).
    //   * The `blogPosts/{post}/revisions` subcollection is likewise DENIED —
    //     the initial revision is written by `/api/admin/blog` (Admin SDK).
    //   * Public READ is preserved but tightened to ONLY the public subset:
    //       jobs       -> isActive == true && deletedAt == null
    //       blogPosts  -> status == 'Published' && deletedAt == null
    //     so drafts, archived jobs and soft-deleted records are never exposed.
    //   * The admin dashboard "Seed Database" button now calls
    //     `/api/admin/seed` (Admin SDK batch, dev-only) instead of a client
    //     writeBatch, so local seeding still works after the write lock.
    //
    // STILL OPEN (separate IU-0 workstreams — do NOT close here without the
    // matching migration, or features break):
    //   * `users` read/write remains open — candidate signup/profile uses
    //     simulated end-user auth (no Firebase Auth yet). Locking requires
    //     Firebase Auth for end-users.
    //   * Signed resume URLs (Storage) — applications detail still shows a
    //     raw object path; a `/api/admin/applications/[id]/resume` signed-URL
    //     route is the documented follow-up.
    //   * `drafts` has NO match here → default-deny. The `useAutosave` hook
    //     still attempts client writes to `drafts`; those silently fail and
    //     fall back to localStorage. Migrating autosave to a server route is a
    //     follow-up (not PII; out of this slice's scope).
    //   * `services` has NO match here → default-deny. Public service pages
    //     read `services` client-side; if that read breaks it is a separate
    //     fix (migrate to a public read rule or server route). The dev seed
    //     writes services via the Admin SDK, which bypasses rules.
    // =====================================================================

    // Public job listings: read active, non-deleted jobs ONLY.
    // WRITE denied — admin jobs CMS runs via /api/admin/jobs (Admin SDK).
    match /jobs/{jobId} {
      allow read: if resource.data.isActive == true && resource.data.deletedAt == null;
      allow write: if false; // use /api/admin/jobs (Admin SDK)
    }

    // Blog posts: read published, non-deleted ONLY; revisions subcollection
    // fully denied (written/read via /api/admin/blog, Admin SDK).
    match /blogPosts/{postId} {
      allow read: if resource.data.status == 'Published' && resource.data.deletedAt == null;
      allow write: if false; // use /api/admin/blog (Admin SDK)
      match /revisions/{revId} {
        allow read, write: if false; // use /api/admin/blog (Admin SDK)
      }
    }

    // Public-submit collections (inbound only).
    //   * Browser CREATE is DENIED (Phase 1B) — submissions go through the
    //     server-side API routes, which write via the Admin SDK.
    //   * READ / UPDATE / DELETE are now DENIED (Phase 4 IU-0 slice 1) — admin
    //     CRM reads/mutates these via /api/admin/** (Admin SDK). No public or
    //     client access remains.
    match /jobApplications/{appId} {
      allow create: if false; // use /api/job-applications
      allow read, update, delete: if false; // use /api/admin/applications
    }
    match /leads/{leadId} {
      allow create: if false; // use /api/contact
      allow read, update, delete: if false; // use /api/admin/leads
    }
    match /newsletterSubscribers/{subId} {
      allow create: if false; // use /api/newsletter
      allow read, update, delete: if false; // use /api/admin/newsletter
    }

    // Admin activity log: written and read ONLY via /api/admin/activity (Admin
    // SDK). No client access.
    match /adminActivityLogs/{logId} {
      allow read, write: if false; // use /api/admin/activity
    }

    // `admins` collection is NOT used by any client code (admin auth is env/JWT
    // based). LOCKED DOWN — deny all.
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // Public services catalogue. The public Services page and the homepage
    // services section read this collection client-side (src/app/services,
    // src/components/sections/services-section). Without a read rule the
    // production Firestore default-denies these reads, leaving the Services
    // page blank (G16). Public READ is restricted to active, non-deleted
    // service records only; all writes go through /api/admin/services (Admin
    // SDK), so writes remain denied to clients.
    match /services/{serviceId} {
      allow read: if resource.data.isActive == true && resource.data.deletedAt == null;
      allow write: if false; // use /api/admin/services (Admin SDK)
    }

    // User profiles. Simulated end-user auth (localStorage) — no Firebase Auth
    // to gate by uid yet. TODO: restrict to request.auth.uid == userId once
    // Firebase Auth is adopted (separate workstream). Left open intentionally
    // so candidate signup/profile still works.
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
