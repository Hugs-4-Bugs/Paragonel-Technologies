rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to active jobs and published blog posts
    match /jobs/{jobId} {
      allow read: if resource.data.isActive == true && resource.data.deletedAt == null;
      allow write: if true; // Admin panel simulated auth
    }
    match /blogPosts/{postId} {
      allow read: if resource.data.status == 'Published' && resource.data.deletedAt == null;
      allow write: if true; // Admin panel simulated auth
      
      match /revisions/{revId} {
        allow read, write: if true;
      }
    }
    
    // Allow creation of applications and leads by anyone
    match /jobApplications/{appId} {
      allow create: if true;
      allow read, write: if true; // Admin panel access
    }
    match /leads/{leadId} {
      allow create: if true;
      allow read, write: if true; // Admin panel access
    }
    match /newsletterSubscribers/{subId} {
      allow create: if true;
      allow read, write: if true; // Admin panel access
    }
    
    // Admin collections
    match /admins/{adminId} {
      allow read, write: if true;
    }
    match /adminActivityLogs/{logId} {
      allow read, create: if true;
    }
    
    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
