rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allows public read access to jobs and blog posts
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if request.auth != null || request.headers.origin.contains('localhost'); // Relaxed for seeding during dev
    }
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if request.auth != null || request.headers.origin.contains('localhost');
    }
    match /jobApplications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /chatSessions/{sessionId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
