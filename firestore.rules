rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // SECURITY (Phase 4, IU-0 slice 1 — PII read-lockdown):
    //
    // Admin data access for `leads`, `jobApplications`, `newsletterSubscribers`
    // and `adminActivityLogs` has been moved SERVER-SIDE to JWT-verified
    // `/api/admin/**` route handlers that use the Firebase Admin SDK (which
    // bypasses these rules). The admin CRM/CMS/Activity pages now fetch/mutate
    // through those routes instead of the client SDK.
    //
    // Therefore these four collections are now DENIED to all client (browser)
    // access — anonymous or otherwise. Public inbound submissions still work
    // because /api/contact, /api/newsletter and /api/job-applications write via
    // the Admin SDK (`create: if false` here is enforced and bypassed server-side).
    //
    // STILL OPEN (next IU-0 slices — do NOT close here without the matching
    // server-side migration, or admin breaks):
    //   * `jobs` and `blogPosts` WRITE remain `if true` because the blog/jobs
    //     admin CMS still writes client-side. Locking them requires migrating
    //     blog/jobs CRUD to `/api/admin/**` (next slice).
    //   * `users` read/write remains open because candidate signup/profile uses
    //     simulated end-user auth (no Firebase Auth yet). Locking requires
    //     Firebase Auth for end-users (separate workstream).
    //   * Signed resume URLs (Storage) — applications detail still shows a
    //     raw object path; a `/api/admin/applications/[id]/resume` signed-URL
    //     route is the documented follow-up.
    // =====================================================================

    // Public job listings: read active, non-deleted jobs.
    // WRITE stays open for now (admin jobs CMS is still client-side — next slice).
    match /jobs/{jobId} {
      allow read: if resource.data.isActive == true && resource.data.deletedAt == null;
      allow write: if true; // TODO(next slice): migrate /admin/jobs CRUD to /api/admin/jobs, then `allow write: if false`.
    }

    // Blog posts: read published, non-deleted; revisions subcollection.
    // WRITE stays open for now (admin blog CMS is still client-side — next slice).
    match /blogPosts/{postId} {
      allow read: if resource.data.status == 'Published' && resource.data.deletedAt == null;
      allow write: if true; // TODO(next slice): migrate /admin/blog CRUD to /api/admin/blog, then `allow write: if false`.
      match /revisions/{revId} {
        allow read, write: if true; // TODO(next slice): lock with blog CMS migration.
      }
    }

    // Public-submit collections (inbound only).
    //   * Browser CREATE is DENIED (Phase 1B) — submissions go through the
    //     server-side API routes, which write via the Admin SDK.
    //   * READ / UPDATE / DELETE are now DENIED (Phase 4 IU-0 slice 1) — admin
    //     CRM reads/mutates these via /api/admin/** (Admin SDK). No public or
    //     client access remains.
    match /jobApplications/{appId} {
      allow create: if false; // use /api/job-applications
      allow read, update, delete: if false; // use /api/admin/applications
    }
    match /leads/{leadId} {
      allow create: if false; // use /api/contact
      allow read, update, delete: if false; // use /api/admin/leads
    }
    match /newsletterSubscribers/{subId} {
      allow create: if false; // use /api/newsletter
      allow read, update, delete: if false; // use /api/admin/newsletter
    }

    // Admin activity log: written and read ONLY via /api/admin/activity (Admin
    // SDK). No client access.
    match /adminActivityLogs/{logId} {
      allow read, write: if false; // use /api/admin/activity
    }

    // `admins` collection is NOT used by any client code (admin auth is env/JWT
    // based). LOCKED DOWN — deny all.
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // User profiles. Simulated end-user auth (localStorage) — no Firebase Auth
    // to gate by uid yet. TODO: restrict to request.auth.uid == userId once
    // Firebase Auth is adopted (separate workstream). Left open intentionally
    // so candidate signup/profile still works.
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
