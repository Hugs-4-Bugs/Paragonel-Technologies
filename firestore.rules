
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is admin
    function isAdmin() {
      return request.auth != null;
    }

    // Public Reads (filtering by deletedAt is handled in app logic)
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /portfolio/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Data Capture (Public Creates)
    match /jobApplications/{appId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /newsletterSubscribers/{subId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    // Admin Only
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
    match /adminActivityLogs/{logId} {
      allow create: if true; // Allowed so client can log actions
      allow read: if isAdmin();
      allow update, delete: if false; // Audit logs are immutable
    }
    match /chatSessions/{sessionId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
