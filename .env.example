# Paragonel Technologies — environment template (PLACEHOLDERS ONLY)
# Copy to .env and fill in real values. Never commit real credentials.
# .env is gitignored; only this .env.example file is tracked.

# ---- AI (Genkit / Google Gemini) ----
# Server-side secret. REQUIRED for AI features (chat, tech-news, resume analysis).
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# ---- Firebase web config (public-by-design; identifies the project) ----
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ---- Admin authentication ----
# JWT secret for signing admin session tokens. REQUIRED, min 32 chars, strong random.
# Generate with:  openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars

# Admin login email.
ADMIN_EMAIL=admin@example.com

# bcrypt hash of the admin password (NOT the plaintext password).
# Generate with:  node -e "console.log(require('bcryptjs').hashSync('your-password',10))"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash-of-admin-password

# ---- Auth redesign: SMTP-OTP + Super Admin RBAC (PENDING implementation) ----
# These are NOT yet enforced by code. The current admin auth remains JWT+password
# (fail-closed; see src/app/api/admin/auth/login + src/lib/admin-auth.ts) and must
# keep working until the dedicated auth task swaps it in. Documented here so that
# task has the env contract ready. See docs/AUTH_IMPLEMENTATION_PLAN.md.
#
# Super Admin bootstrap email (one-time secure bootstrap; NO public Super Admin signup).
SUPERADMIN_BOOTSTRAP_EMAIL=contact@prabhat.online
# OTP HMAC secret (separate from JWT_SECRET; min 32 chars). Signs OTP request IDs so
# the verify step can confirm they were server-issued. Generate: openssl rand -hex 32
OTP_SECRET=replace-with-a-strong-random-secret-min-32-chars

# ---- Firebase Admin SDK (server-side; Phase 1B) ----
# REQUIRED in production for server-side Firestore/Storage writes via the API
# routes (/api/contact, /api/newsletter, /api/job-applications). In local dev
# these are NOT needed — set FIRESTORE_EMULATOR_HOST instead and the Admin SDK
# connects to the emulator without credentials. Never invent these values.
FIREBASE_ADMIN_PROJECT_ID=your-firebase-admin-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"

# ---- Email (SMTP / Mailpit; Phase 1B) ----
# Production SMTP for outbound notifications. The app starts even when these are
# unset; in local dev the email service falls back to Mailpit automatically.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address for outgoing mail, e.g.  Paragonel <noreply@example.com>
SMTP_FROM=
# Recipient for enquiry notifications (provided later). If unset, the company
# notification is SKIPPED (never faked). Acknowledgement to the submitter still
# attempts to send via the configured transport.
COMPANY_INBOX=
# Public base URL used in email body links.
APP_BASE_URL=http://localhost:3000

# ---- Local development emulator / Mailpit (LOCAL ONLY; do NOT set in prod) ----
# Set these in your local .env to route all Firebase Admin SDK writes to the
# emulator and email to Mailpit. NEVER set them in production.
# FIRESTORE_EMULATOR_HOST=localhost:8080
# STORAGE_EMULATOR_HOST=localhost:9199
# MAILPIT_HOST=localhost
# MAILPIT_SMTP_PORT=1025
