# Paragonel Technologies — environment template (PLACEHOLDERS ONLY)
# Copy to .env.local and fill in real values. Never commit real credentials.
# .env.local is gitignored; only this .env.example + .env.template are tracked.
#
# ARCHITECTURE NOTE: Supabase is the approved primary backend. The Supabase
# schema + RLS + client lib + migration tooling are complete (see
# supabase/migrations/ + src/lib/supabase/). The Firebase variables below are
# RETAINED because the route-level data-access cutover is the next batch —
# removing them before the routes are swapped would break the running app.
# Once the routes are migrated + the founder confirms the Supabase cutover,
# delete the entire Firebase section.

# =============================================================================
# SUPABASE (primary backend — provision a project at https://supabase.com)
# =============================================================================
# Apply the schema: supabase/migrations/0001..0005 (supabase db push or SQL editor).
# The anon key is public (browser); the service-role key is server-only + bypasses RLS.

# Public (browser) — safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server-only secret — NEVER expose in NEXT_PUBLIC_* or client code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# (Optional) separate URL for the server client if it differs from the public URL.
# SUPABASE_URL=https://your-project.supabase.co

# =============================================================================
# AI (Genkit / Google Gemini) — server-side secret
# =============================================================================
# REQUIRED for AI features (chatbot, resume parsing, tech-news). Without it the
# chatbot returns an honest fallback (HTTP 503, retryable) + resume parse is skipped.
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
# Model id (without the googleai/ prefix). Defaults to gemini-flash-latest (the
# documented current alias). Pin to gemini-2.0-flash if your key lacks the latest.
GEMINI_MODEL=gemini-flash-latest
# Bounded model-request timeout in ms (default 25000). Prevents perpetual loading.
GEMINI_REQUEST_TIMEOUT_MS=25000

# =============================================================================
# Email (SMTP / Mailpit) — one provider, one delivery path
# =============================================================================
# Production SMTP for outbound notifications (OTP, application confirmation,
# newsletter welcome, job alerts, contact acknowledgement). The app starts even
# when these are unset; in local dev the email service falls back to Mailpit.
# Pick ONE provider (Resend recommended) + verify the sending domain (DNS).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Verified sender on your verified domain: Paragonel <noreply@your-domain.com>
SMTP_FROM=
# Real company inbox for enquiry notifications. If unset, the company
# notification is SKIPPED (never faked).
COMPANY_INBOX=
# Public base URL used in email body links.
APP_BASE_URL=http://localhost:3000

# =============================================================================
# Security (auth) — REQUIRED always
# =============================================================================
# JWT_SECRET signs session tokens (candidate + admin) during the cutover period
# (the existing custom session layer). OTP_SECRET signs OTP request IDs + the
# one-click unsubscribe tokens (job-alerts + newsletter). Both ≥32 chars.
# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars
OTP_SECRET=replace-with-a-strong-random-secret-min-32-chars
# Super Admin bootstrap email (one-time secure bootstrap; NO public super_admin signup).
SUPERADMIN_BOOTSTRAP_EMAIL=contact@prabhat.online

# =============================================================================
# CAPTCHA (Cloudflare Turnstile; REQUIRED in production)
# =============================================================================
# Without these, production registration + login fail closed (dev uses test mode).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# =============================================================================
# FIREBASE — RETAINED DURING CUTOVER (remove after route migration is complete)
# =============================================================================
# The 50 Firebase Admin SDK routes are still active. These vars keep the app
# running until the route data-access layer is swapped to Supabase (next batch).
# In local dev, set FIRESTORE_EMULATOR_HOST instead of the service-account vars.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id
FIREBASE_ADMIN_PROJECT_ID=your-firebase-admin-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
# Legacy single-admin fallback (superseded by the admins/ RBAC collection).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash-of-admin-password

# =============================================================================
# Local development only (NEVER set in production)
# =============================================================================
# Firebase emulator (retained during cutover) + Mailpit (email capture).
FIRESTORE_EMULATOR_HOST=localhost:8080
STORAGE_EMULATOR_HOST=localhost:9199
MAILPIT_HOST=localhost
MAILPIT_SMTP_PORT=1025
