# Paragonel Technologies — .env.template (BLANK — fill in + rename to .env.local)
#
# Founder-facing quick-fill template for the Supabase architecture. For full
# instructions see docs/ENVIRONMENT_SETUP.md. Copy to .env.local and replace
# every <...> value. Never commit .env.local. The startup env-validation
# (src/lib/env-validation.ts) prints a non-sensitive summary of missing vars
# on boot. Generate secrets with: openssl rand -hex 32
#
# The Firebase section is RETAINED during the cutover — remove it after the
# route migration is complete + the founder confirms the Supabase cutover.

# === SUPABASE (primary backend — https://supabase.com dashboard) ===
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase anon/publishable key — public>
SUPABASE_SERVICE_ROLE_KEY=<supabase service-role key — SERVER ONLY, never public>

# === AI (Gemini — https://aistudio.google.com/app/apikey) ===
GEMINI_API_KEY=<gemini api key>
GOOGLE_API_KEY=<alternative to GEMINI_API_KEY>
GEMINI_MODEL=<gemini-flash-latest, or pin to gemini-2.0-flash>
GEMINI_REQUEST_TIMEOUT_MS=<25000>

# === EMAIL / SMTP (one provider — Resend recommended; verify sending domain) ===
SMTP_HOST=<smtp.provider.com or blank for local Mailpit>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp user or api key>
SMTP_PASS=<smtp pass or api key>
SMTP_FROM=Paragonel <noreply@<your-verified-domain>.com>
COMPANY_INBOX=<real company inbox for enquiries>
APP_BASE_URL=http://localhost:3000

# === SECURITY (required always — generate with openssl rand -hex 32) ===
JWT_SECRET=<openssl rand -hex 32>
OTP_SECRET=<openssl rand -hex 32>
SUPERADMIN_BOOTSTRAP_EMAIL=contact@prabhat.online

# === CAPTCHA (Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile) ===
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<turnstile site key — public>
TURNSTILE_SECRET_KEY=<turnstile secret key — server only>

# === FIREBASE — RETAINED DURING CUTOVER (remove after route migration) ===
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase web api key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project-id>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<app-id>
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=<measurement-id-or-blank>
FIREBASE_ADMIN_PROJECT_ID=<project-id>
FIREBASE_ADMIN_CLIENT_EMAIL=<service-account@project.iam.gserviceaccount.com>
FIREBASE_ADMIN_PRIVATE_KEY=<paste with \n escapes>
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=<bcrypt hash>

# === LOCAL DEV ONLY (do NOT set in production) ===
FIRESTORE_EMULATOR_HOST=localhost:8080
STORAGE_EMULATOR_HOST=localhost:9199
MAILPIT_HOST=localhost
MAILPIT_SMTP_PORT=1025
