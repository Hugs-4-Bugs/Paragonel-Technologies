# Paragonel Technologies — .env.template (BLANK — fill in + rename to .env.local)
#
# This is the founder-facing quick-fill template. For full instructions see
# docs/ENVIRONMENT_SETUP.md. Copy to .env.local and replace every <...> value.
# Never commit .env.local. The startup env-validation (src/lib/env-validation.ts)
# will print a non-sensitive summary of anything missing on boot.
#
# Generate secrets with:  openssl rand -hex 32

# === SECURITY (required always) ===
JWT_SECRET=<openssl rand -hex 32>
OTP_SECRET=<openssl rand -hex 32>
SUPERADMIN_BOOTSTRAP_EMAIL=contact@prabhat.online

# === FIREBASE CLIENT (required always — public) ===
NEXT_PUBLIC_FIREBASE_API_KEY=<Firebase console → Web app>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project-id>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<app-id>
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=<measurement-id-or-leave-blank>

# === FIREBASE ADMIN (required in production; not needed locally with emulator) ===
FIREBASE_ADMIN_PROJECT_ID=<project-id>
FIREBASE_ADMIN_CLIENT_EMAIL=<service-account@project.iam.gserviceaccount.com>
FIREBASE_ADMIN_PRIVATE_KEY=<paste with \n escapes>

# === EMAIL / SMTP (optional locally — falls back to Mailpit; required for prod email) ===
SMTP_HOST=<smtp.provider.com or leave blank for Mailpit>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user-or-api-key>
SMTP_PASS=<smtp-pass-or-api-key>
SMTP_FROM=Paragonel <noreply@your-verified-domain.com>
COMPANY_INBOX=<real-company-inbox-for-enquiries>
APP_BASE_URL=http://localhost:3000

# === AI (optional — chatbot + resume parse; without it chatbot returns fallback) ===
GEMINI_API_KEY=<https://aistudio.google.com/app/apikey>
GOOGLE_API_KEY=<alternative to GEMINI_API_KEY>

# === CAPTCHA (required in production; dev uses test mode automatically) ===
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<Cloudflare Turnstile site key>
TURNSTILE_SECRET_KEY=<Cloudflare Turnstile secret key>

# === LOCAL DEV ONLY (do NOT set in production; set automatically by dev-supervisor.sh) ===
FIRESTORE_EMULATOR_HOST=localhost:8080
STORAGE_EMULATOR_HOST=localhost:9199
MAILPIT_HOST=localhost
MAILPIT_SMTP_PORT=1025

# === LEGACY (superseded by admins/ collection + bootstrap flow; keep for fallback) ===
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=<bcrypt hash — node -e "console.log(require('bcryptjs').hashSync('pw',10))">
