{
  "entities": {
    "Admin": {
      "title": "Administrator",
      "description": "System administrator account.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["Founder", "HR"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Job": {
      "title": "Job Opening",
      "description": "A job opening managed via Admin Panel.",
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "title": { "type": "string" },
        "department": { "type": "string" },
        "location": { "type": "string" },
        "employmentType": { "type": "string" },
        "workArrangement": { "type": "string" },
        "experienceRequired": { "type": "string" },
        "salaryRange": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "isActive": { "type": "boolean" },
        "status": { "type": "string", "enum": ["Draft", "Active", "Archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "deletedAt": { "type": "string", "format": "date-time" }
      }
    },
    "JobApplication": {
      "title": "Job Application",
      "description": "Candidate application record (ATS).",
      "type": "object",
      "properties": {
        "candidateName": { "type": "string" },
        "candidateEmail": { "type": "string" },
        "candidatePhone": { "type": "string" },
        "jobId": { "type": "string" },
        "jobTitle": { "type": "string" },
        "resumeUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["New", "Reviewing", "Shortlisted", "Interview Scheduled", "Rejected", "Hired"] },
        "internalNotes": { "type": "string" },
        "appliedAt": { "type": "string", "format": "date-time" },
        "deletedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Lead": {
      "title": "Business Lead",
      "description": "Inquiry from contact forms.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "company": { "type": "string" },
        "message": { "type": "string" },
        "source": { "type": "string" },
        "status": { "type": "string", "enum": ["New", "Contacted", "Qualified", "Closed"] },
        "internalNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "deletedAt": { "type": "string", "format": "date-time" }
      }
    },
    "NewsletterSubscriber": {
      "title": "Newsletter Subscriber",
      "description": "Email subscription for marketing.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "source": { "type": "string" },
        "subscribedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Record of administrative actions.",
      "type": "object",
      "properties": {
        "adminEmail": { "type": "string" },
        "action": { "type": "string" },
        "resourceType": { "type": "string" },
        "resourceId": { "type": "string" },
        "ipAddress": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "Article with SEO and scheduling.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "body": { "type": "string" },
        "excerpt": { "type": "string" },
        "metaTitle": { "type": "string" },
        "metaDescription": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["Published", "Draft", "Scheduled"] },
        "publishAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "deletedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/admins/{adminId}": { "schema": "#/backend/entities/Admin", "description": "Admin users." },
    "/jobs/{jobId}": { "schema": "#/backend/entities/Job", "description": "Job openings." },
    "/jobApplications/{appId}": { "schema": "#/backend/entities/JobApplication", "description": "Job applications." },
    "/leads/{leadId}": { "schema": "#/backend/entities/Lead", "description": "Business leads." },
    "/newsletterSubscribers/{subId}": { "schema": "#/backend/entities/NewsletterSubscriber", "description": "Email list." },
    "/adminActivityLogs/{logId}": { "schema": "#/backend/entities/AuditLog", "description": "Security logs." },
    "/blogPosts/{postId}": { "schema": "#/backend/entities/BlogPost", "description": "Blog content." },
    "/blogPosts/{postId}/revisions/{revId}": { "schema": "#/backend/entities/BlogPost", "description": "Blog post revisions." }
  }
}
