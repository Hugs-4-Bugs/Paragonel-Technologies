{
  "entities": {
    "ChatSession": {
      "title": "Chat Session",
      "description": "Represents a chat conversation session between a user and QuantumAI.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "sessionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      },
      "required": ["sessionId", "createdAt"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "An individual message within a chat session.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "ai"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "role", "content", "timestamp"]
    },
    "Job": {
      "title": "Job Opening",
      "description": "A job opening managed via Admin Panel.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "department": { "type": "string" },
        "location": { "type": "string" },
        "employmentType": { "type": "string" },
        "experience": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "salaryRange": { "type": "string" },
        "description": { "type": "string" },
        "deadline": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Draft"] },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "department", "location", "employmentType", "description"]
    },
    "JobApplication": {
      "title": "Job Application",
      "description": "A job application submitted through the website or QuantumAI.",
      "type": "object",
      "properties": {
        "applicationId": { "type": "string" },
        "jobId": { "type": "string" },
        "jobTitle": { "type": "string" },
        "candidateName": { "type": "string" },
        "candidateEmail": { "type": "string" },
        "candidatePhone": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "experienceYears": { "type": "number" },
        "resumeUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["submitted", "reviewing", "shortlisted", "rejected"] },
        "appliedAt": { "type": "string", "format": "date-time" },
        "appliedVia": { "type": "string", "enum": ["form", "ai"] }
      },
      "required": ["applicationId", "jobId", "candidateEmail", "appliedAt"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "An article published on the company blog.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "author": { "type": "string" },
        "coverImageUrl": { "type": "string" },
        "summary": { "type": "string" },
        "body": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["Published", "Draft"] },
        "publishedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "body"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/chatSessions/{sessionId}": {
      "schema": "#/backend/entities/ChatSession",
      "description": "Collection of active and past chat sessions."
    },
    "/chatSessions/{sessionId}/messages/{messageId}": {
      "schema": "#/backend/entities/ChatMessage",
      "description": "Messages belonging to a specific chat session."
    },
    "/jobs/{jobId}": {
      "schema": "#/backend/entities/Job",
      "description": "Job openings available at the company."
    },
    "/jobApplications/{applicationId}": {
      "schema": "#/backend/entities/JobApplication",
      "description": "Job applications received by the company."
    },
    "/blogPosts/{postId}": {
      "schema": "#/backend/entities/BlogPost",
      "description": "Articles published on the company blog."
    }
  }
}