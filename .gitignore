# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# service-account / key files (never commit — even though the Firebase Admin
# private key is delivered via the FIREBASE_ADMIN_PRIVATE_KEY env var, a dropped
# service-account JSON or PEM must never be tracked)
service-account*.json
serviceAccount*.json
*.key
*.keystore

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
# secrets / env files — never commit real credentials
.env*
!.env.example
!.env.template

# firebase
firebase-debug.log
firestore-debug.log

# local runtime artifacts (dev server logs, etc.)
.runtime/logs/

# dev-supervisor runtime logs
/logs/
